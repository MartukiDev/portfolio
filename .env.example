# Supabase: Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clave publishable (sb_publishable_...). Con claves legacy, usar la anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública del sitio (links absolutos en correos; SEO en la Fase 9)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend: aviso por correo de mensajes del formulario de contacto
# https://resend.com/api-keys — el dominio del remitente debe estar verificado en Resend.
RESEND_API_KEY=re_xxx
CONTACT_FROM_EMAIL="martojs <contacto@martojs.cl>"
